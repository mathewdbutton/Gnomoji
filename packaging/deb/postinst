#!/bin/sh
# Runs as root after the package is unpacked, on install and on upgrade. Only unpacking can
# fail the install: everything here is best-effort.
set -e

if [ "$1" = configure ]; then
    # Compile first, so the restarted picker uses the compiled files.
    py3compile /usr/lib/emoji-picker || true
    sh /usr/lib/emoji-picker/enable-for-everyone || true
fi

exit 0
