#!/bin/sh
# Runs as root before the package's files are removed. On upgrade it only cleans bytecode:
# the new postinst restarts the picker, so nothing here stops or disables it then.
set -e

# A root-owned __pycache__ must never block removal.
case "$1" in
    remove|upgrade) py3clean /usr/lib/emoji-picker || true ;;
esac

if [ "$1" = remove ]; then
    sh /usr/lib/emoji-picker/disable-for-everyone || true
fi

exit 0
