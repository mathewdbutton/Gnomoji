# Template: install.sh and packaging/build.sh replace the APPDIR placeholder with the
# folder holding the emoji_picker package.
[Unit]
Description=Gnomoji (double-tap right Shift)
PartOf=graphical-session.target
After=graphical-session.target
ConditionUser=!@system
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Environment="PYTHONPATH=@APPDIR@"
ExecStart=/usr/bin/python3 -m emoji_picker
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
